{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ableton LOM Discovery Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.4.0"
    },
    "live_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "devices"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "path",
                "parameters"
              ],
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "class_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "class_display_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "path",
                      "value",
                      "min",
                      "max",
                      "is_enabled",
                      "automation_state"
                    ],
                    "properties": {
                      "id": {
                        "type": [
                          "integer",
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": "string"
                      },
                      "original_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "value": {
                        "type": "number"
                      },
                      "display_value": {
                        "type": [
                          "string",
                          "number",
                          "null"
                        ]
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "is_quantized": {
                        "type": "boolean"
                      },
                      "value_items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "is_enabled": {
                        "type": "boolean"
                      },
                      "automation_state": {
                        "type": "integer",
                        "enum": [
                          0,
                          1,
                          2
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
