{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harmony-spec.schema.json",
  "title": "HarmonySpec v18",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "mode",
    "track_name",
    "events",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "18.0"
    },
    "key": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "track_name": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bar",
          "beat",
          "duration_beats",
          "symbol",
          "midi_notes",
          "velocity"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 1
          },
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "duration_beats": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "symbol": {
            "type": "string"
          },
          "midi_notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "source_ids"
      ],
      "properties": {
        "level": {
          "enum": [
            "DOC",
            "ATTRIB",
            "ANALYSIS",
            "HEUR",
            "TEST"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
