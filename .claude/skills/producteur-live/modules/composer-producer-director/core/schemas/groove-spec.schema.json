{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groove-spec.schema.json",
  "title": "GrooveSpec v18",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style_lock",
    "bpm",
    "meter",
    "ppq",
    "bars",
    "pulse",
    "timeline",
    "roles",
    "timing_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "18.0"
    },
    "style_lock": {
      "type": "string"
    },
    "bpm": {
      "type": "number",
      "minimum": 40,
      "maximum": 240
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "denominator": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        }
      }
    },
    "ppq": {
      "type": "integer",
      "minimum": 96
    },
    "bars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "pulse": {
      "type": "string"
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "evidence"
      ],
      "properties": {
        "pattern_id": {
          "type": "string"
        },
        "orientation": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "source_ids"
          ],
          "properties": {
            "level": {
              "enum": [
                "DOC",
                "ATTRIB",
                "ANALYSIS",
                "HEUR",
                "TEST"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "timing_profile": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "function",
          "track_name",
          "midi_note",
          "events"
        ],
        "properties": {
          "role_id": {
            "type": "string"
          },
          "function": {
            "enum": [
              "BACKBONE",
              "TIMELINE",
              "LOW_PERC",
              "MID_PERC",
              "HIGH_TIMEKEEPER",
              "SYNCOPATION",
              "ACCENT",
              "MOTION",
              "FILL",
              "EAR_CANDY"
            ]
          },
          "track_name": {
            "type": "string"
          },
          "midi_note": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bar",
                "beat",
                "duration_beats",
                "velocity",
                "micro_offset_beats",
                "articulation"
              ],
              "properties": {
                "bar": {
                  "type": "integer",
                  "minimum": 1
                },
                "beat": {
                  "type": "number",
                  "minimum": 0
                },
                "duration_beats": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 127
                },
                "micro_offset_beats": {
                  "type": "number",
                  "minimum": -0.25,
                  "maximum": 0.25
                },
                "articulation": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "source_ids"
      ],
      "properties": {
        "level": {
          "enum": [
            "DOC",
            "ATTRIB",
            "ANALYSIS",
            "HEUR",
            "TEST"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
